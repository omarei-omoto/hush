{
  "name": "@omarei/hush",
  "version": "0.9.0",
  "description": "Envelope-encrypted team secrets your AI agent can use but never read. Zero dependencies, zero servers — your git repo is the backend.",
  "keywords": [
    "secrets",
    "dotenv",
    "env",
    "encryption",
    "mcp",
    "ai-agent",
    "claude-code",
    "x25519",
    "team",
    "vault"
  ],
  "license": "MIT",
  "author": "omarei",
  "homepage": "https://github.com/omarei-omoto/hush#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omarei-omoto/hush.git"
  },
  "bugs": {
    "url": "https://github.com/omarei-omoto/hush/issues"
  },
  "type": "module",
  "mcpName": "io.github.omarei-omoto/hush",
  "bin": {
    "hush": "bin/hush.js"
  },
  "exports": {
    ".": {
      "types": "./dist/vault.d.ts",
      "default": "./dist/vault.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "skills",
    "native",
    "docs",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "hush": "node src/cli.ts",
    "test": "node --test test/*.test.ts test/commands/*.test.ts",
    "test:binary": "node --import ./test/helpers/binary-shim.ts --test test/*.test.ts test/commands/*.test.ts",
    "build:binaries": "node scripts/build-binaries.mjs",
    "docs:commands": "node scripts/gen-commands.mjs",
    "docs:build": "node scripts/gen-commands.mjs --check && node scripts/build-docs.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:check": "node scripts/check-reproducible.mjs",
    "prepack": "node scripts/check-pack.mjs && npm run build",
    "version": "node scripts/sync-version.mjs && git add src/version.ts server.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.8.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
