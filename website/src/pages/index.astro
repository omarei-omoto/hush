---
/**
 * tryhush.dev's home page. The docs (src/content/docs) are Starlight's; this
 * page is its own: Tailwind (src/styles/landing.css, loaded here only), with
 * React islands for what moves. The window in the hero runs the real app,
 * built into /demo/ by ../scripts/build-demo.mjs.
 */
import "../styles/landing.css";
import pkg from "../../../package.json";
import logo from "../../../assets/logo.svg?raw";
import mark from "../../../assets/logo-mark.svg?raw";
import { Hero } from "../components/landing/Hero";
import { HowItWorks } from "../components/landing/HowItWorks";
import { Commands } from "../components/landing/Commands";
import { Features } from "../components/landing/Features";
import { Install } from "../components/landing/Install";

const SITE = "https://tryhush.dev";
const REPO = "https://github.com/omarei-omoto/hush";
const version = pkg.version.split(".").slice(0, 2).join(".");
const title = "hush — secrets your AI agent can use but never read";
const description =
  "Envelope-encrypted team secrets that live in your repo. Your coding agent runs your app with your keys and only ever sees [redacted]. No server, no account, no shared password.";
// The marks as inline SVG in currentColor, so they follow the theme; the label is on the link.
const quiet = (svg: string) => svg.replace(' role="img" aria-label="hush"', ' aria-hidden="true" class="h-full w-auto"');

const nav = [
  { label: "Guide", href: "/guide/" },
  { label: "Overview", href: "/overview/" },
  { label: "Security", href: "/security/" },
  { label: "Changelog", href: "/changelog/" },
];
const agents = ["Claude Code", "Codex", "Cursor", "Windsurf", "Gemini CLI", "VS Code", "Zed", "Cline"];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/assets/social-preview.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0e0e0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f1ed" media="(prefers-color-scheme: light)" />
    {/* The theme the docs remember (Starlight keeps it under this name), before anything paints. */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("starlight-theme");
        } catch {}
        const theme = stored === "light" || stored === "dark" ? stored : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <a href="#main" class="sr-only z-50 rounded-lg bg-foreground px-3 py-2 text-background focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>

    <header class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-300 data-[scrolled]:border-border data-[scrolled]:bg-background/75 data-[scrolled]:backdrop-blur-xl" id="top-bar">
      <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-4 sm:px-6" aria-label="Main">
        <a href="/" class="flex h-[22px] items-center text-foreground" aria-label="hush, home" set:html={quiet(logo)} />
        <div class="hidden items-center gap-1 md:flex">
          {nav.map((n) => <a href={n.href} class="rounded-lg px-3 py-1.5 text-[14px] text-muted-foreground transition hover:bg-sunken hover:text-foreground">{n.label}</a>)}
        </div>
        <div class="ml-auto flex items-center gap-1.5">
          <a href={REPO} class="hidden h-9 items-center gap-2 rounded-lg px-3 text-[14px] text-muted-foreground transition hover:bg-sunken hover:text-foreground sm:flex">
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.56 9.56 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z" /></svg>
            GitHub
          </a>
          <button type="button" id="theme" class="grid size-9 place-items-center rounded-lg text-muted-foreground transition hover:bg-sunken hover:text-foreground" aria-label="Switch between light and dark">
            <svg viewBox="0 0 24 24" class="size-[18px] dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
            <svg viewBox="0 0 24 24" class="hidden size-[18px] dark:block" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 4V2.5M12 21.5V20M4 12H2.5M21.5 12H20M6.3 6.3 5.2 5.2M18.8 18.8l-1.1-1.1M6.3 17.7l-1.1 1.1M18.8 5.2l-1.1 1.1M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0" /></svg>
          </button>
          <a href="/guide/setting-up/" class="ml-1 inline-flex h-9 items-center rounded-lg bg-foreground px-3.5 text-[14px] font-semibold text-background transition hover:opacity-90">Get started</a>
        </div>
      </nav>
    </header>

    <main id="main">
      <Hero client:load version={version} />

      <section class="mx-auto max-w-5xl px-4 pt-10 pb-6 text-center sm:px-6" aria-label="Works with">
        <p class="text-[13px] text-muted-foreground">Works with the coding agents you already use, through MCP</p>
        <ul class="mt-5 flex flex-wrap justify-center gap-x-8 gap-y-3">
          {agents.map((a) => <li class="font-display text-[17px] font-semibold tracking-[-0.02em] text-muted-foreground/80">{a}</li>)}
        </ul>
      </section>

      <HowItWorks client:visible mark={quiet(mark)} />
      <Commands client:visible />
      <Features client:visible />

      <section class="mx-auto max-w-6xl px-4 sm:px-6" aria-labelledby="early">
        <div class="grain relative overflow-hidden rounded-3xl border border-border bg-card p-7 sm:p-12">
          <div class="grid gap-10 md:grid-cols-[1.1fr_1fr]">
            <div>
              <p class="text-[13px] font-semibold tracking-[0.12em] text-ok uppercase">Status: early</p>
              <h2 id="early" class="mt-3 font-display text-[clamp(1.8rem,3.6vw,2.6rem)] leading-[1.08] font-semibold tracking-[-0.04em] text-balance">
                Heavily tested. Not yet reviewed. Honest about both.
              </h2>
              <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-ink-2">
                hush is pre-1.0, it has one author, and it has not had an external security review. The crypto is a standard construction — age's — rather than anything
                invented here, with a differential test suite against an independent reimplementation. That is not the same as someone qualified having looked at it.
              </p>
            </div>
            <ul class="space-y-3 self-center">
              {
                [
                  { href: "/review-scope/", title: "The brief for the review it needs", body: "What hush claims, and where each claim lives in the code." },
                  { href: "/red-team/", title: "Can an agent get a value out?", body: "The red-team pass: every probe, and what it found." },
                  { href: "/security/", title: "Security policy", body: "The threat model: what hush defends against, and what it does not." },
                  { href: `${REPO}/security/advisories/new`, title: "Found a way in? Report it privately", body: "Rather than in an issue." },
                ].map((l) => (
                  <li>
                    <a href={l.href} class="group flex items-center gap-4 rounded-2xl border border-border bg-background/60 px-5 py-4 transition hover:border-border-strong">
                      <div class="min-w-0">
                        <div class="text-[14.5px] font-semibold">{l.title}</div>
                        <div class="mt-0.5 text-[13px] text-muted-foreground">{l.body}</div>
                      </div>
                      <svg viewBox="0 0 24 24" class="ml-auto size-4 shrink-0 text-muted-foreground transition group-hover:translate-x-0.5 group-hover:text-foreground" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <Install client:visible />

      <section class="relative isolate overflow-hidden border-t border-border">
        <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_80%_at_50%_100%,var(--glow),transparent_70%)]"></div>
        <div class="mx-auto max-w-4xl px-4 py-28 text-center sm:px-6 sm:py-36">
          <div class="mx-auto mb-8 size-14 text-foreground" set:html={quiet(mark)} />
          <h2 class="font-display text-[clamp(2.2rem,5.4vw,4rem)] leading-[1.03] font-semibold tracking-[-0.045em] text-balance">
            Give your agent the keys.<br /><span class="text-muted-foreground">Not the secrets.</span>
          </h2>
          <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="/guide/setting-up/" class="inline-flex h-12 items-center rounded-xl bg-foreground px-6 text-[15px] font-semibold text-background transition hover:opacity-90">Get started</a>
            <a href="/guide/" class="inline-flex h-12 items-center rounded-xl border border-border-strong px-6 text-[15px] font-semibold transition hover:bg-sunken">Read the guide</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 md:flex-row md:items-start">
        <div class="max-w-xs">
          <a href="/" class="flex h-5 items-center text-foreground" aria-label="hush, home" set:html={quiet(logo)} />
          <p class="mt-4 text-[13px] leading-relaxed text-muted-foreground">Envelope-encrypted team secrets your AI agent can use but never read. MIT licensed.</p>
        </div>
        <div class="grid flex-1 grid-cols-2 gap-8 sm:grid-cols-3 md:justify-items-end">
          {
            [
              { title: "Learn", links: [["The guide", "/guide/"], ["Overview", "/overview/"], ["Setting up", "/guide/setting-up/"], ["Sending keys to hosts", "/guide/sending-keys-to-your-hosts/"]] },
              { title: "Trust", links: [["Security policy", "/security/"], ["Red team", "/red-team/"], ["Review scope", "/review-scope/"], ["Architecture", "/architecture/"]] },
              { title: "Project", links: [["GitHub", REPO], ["npm", "https://www.npmjs.com/package/@omarei/hush"], ["Changelog", "/changelog/"], ["Contributing", "/contributing/"]] },
            ].map((col) => (
              <div>
                <div class="text-[12px] font-semibold tracking-[0.1em] text-muted-foreground uppercase">{col.title}</div>
                <ul class="mt-3 space-y-2">
                  {col.links.map(([label, href]) => (
                    <li><a href={href} class="text-[14px] text-ink-2 transition hover:text-foreground">{label}</a></li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </footer>

    <script>
      // The bar gets a background once the page moves under it.
      const bar = document.getElementById("top-bar");
      const onScroll = () => bar?.toggleAttribute("data-scrolled", scrollY > 8);
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // Light or dark, remembered where the docs remember it.
      document.getElementById("theme")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
